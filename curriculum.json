{
  "title": "AIVault Curriculum — Aligned with HackPath 7-Pillar Roadmap",
  "overview": "Beginner-to-advanced cybersecurity lab covering all major domains from technical foundations through advanced specializations, aligned with HackPath, CyBOK, NICE, MITRE ATT&CK, and OWASP frameworks.",
  "reference_frameworks": [
    "CyBOK — Cybersecurity Body of Knowledge",
    "NICE — NIST Workforce Framework",
    "ECSF — ENISA European Cybersecurity Skills Framework",
    "MITRE ATT&CK — Adversary tactics & techniques",
    "OWASP — Application security guidance"
  ],
  "pillars": [
    {
      "id": 1,
      "name": "Technical Foundations",
      "why": "Everything else assumes you understand how computers, networks, and operating systems actually work."
    },
    {
      "id": 2,
      "name": "Security Engineering & Attack Surfaces",
      "why": "Modern attack surface: identity, web apps, cloud, code pipelines."
    },
    {
      "id": 3,
      "name": "Offensive Security",
      "why": "You cannot reliably defend what you cannot attack."
    },
    {
      "id": 4,
      "name": "Defensive Operations",
      "why": "Detect, respond, learn — most cybersecurity jobs live here."
    },
    {
      "id": 5,
      "name": "Advanced & Specialized Security",
      "why": "Deep niches: malware, reverse engineering, mobile, wireless, IoT, AI/ML."
    },
    {
      "id": 6,
      "name": "Governance, Architecture & Assurance",
      "why": "Security only scales if designed into the organization."
    },
    {
      "id": 7,
      "name": "Professional Practice, Research & Career",
      "why": "Technical skill alone does not make a career."
    }
  ],
