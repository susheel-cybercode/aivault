<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: title }) %>
<body>
<%- include('../partials/header') %>

<h1>Command Injection</h1>
<form method="GET" action="/injection/command-injection">
  <input name="host" placeholder="Enter IP/host to ping" value="127.0.0.1">
  <button>Ping</button>
</form>
<p class="hint">Try: <code>127.0.0.1; ls -la</code> or <code>127.0.0.1 && cat /etc/passwd</code></p>
<p>The backend runs: <code>ping -c 2 [user_input]</code></p>

<%- include('../partials/footer') %>
</body>
</html>
