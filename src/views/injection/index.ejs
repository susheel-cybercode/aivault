<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>A03 Injection</title><link rel="stylesheet" href="/css/terminal.css"></head>
<body><div class="terminal-container"><div class="terminal-header"><span class="terminal-title">[A03] Injection Lab</span></div>
<div class="terminal-body">
<h1>A03:2021 – Injection</h1>
<div class="challenge-grid" style="grid-template-columns: 1fr 1fr">
<div class="challenge-card">
<h3>SQL Injection</h3>
<form method="GET" action="/injection/sqli/search">
  <input name="q" placeholder="Search users..."><button>Search</button>
</form>
<code>SELECT * FROM users WHERE username LIKE '%[input]%'</code>
<p>Try: <code>admin' UNION SELECT 1,2,3,4,5,6 --</code></p>
</div>
<div class="challenge-card">
<h3>NoSQL Injection</h3>
<form method="GET" action="/injection/nosql">
<input name="username" placeholder="Username"><button>Query</button>
</form>
<p>Try: <code>{ $ne: "" }</code></p>
</div>
</div>
<p><a href="/injection/xss/reflected?name=test">Reflected XSS</a> | <a href="/injection/xss/stored">Stored XSS</a> | <a href="/injection/ssti">SSTI</a> | <a href="/injection/command-injection">Command Injection</a></p>
</div></div></body></html>