<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: title }) %>
<body>
<%- include('../partials/header') %>

<h1>Client-Side Template Injection (CSTI)</h1>
<p>Template source (untrusted):</p>
<pre><%= template %></pre>
<p>Result when the template engine renders it server-side:</p>
<div style="border:1px solid #333;padding:1rem;background:#0a0a0a">
  <%- template %>
</div>
<p class="hint">Try: <code>?template=<h1>Test {{}}</code> or Angular-style <code>{{$root.constructor.constructor('alert(1)')()}}</code></p>

<%- include('../partials/footer') %>
</body>
</html>
