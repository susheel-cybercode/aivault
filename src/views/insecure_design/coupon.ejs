<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: title }) %>
<body>
<%- include('../partials/header') %>

<h1>Coupon Business Logic</h1>
<form method="POST" action="/insecure-design/apply-coupon">
  <input name="price" placeholder="Price" value="100">
  <input name="code" placeholder="Coupon code">
  <button>Apply</button>
</form>
<p class="hint">Try: <code>SUMMER50</code>, <code>FLAT10</code>, <code>FREE</code>. Same coupon can apply multiple times.</p>
<p>Also try <code>POST /insecure-design/bulk-order</code> with array bypass.</p>

<%- include('../partials/footer') %>
</body>
</html>
