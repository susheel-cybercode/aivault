<!DOCTYPE html>
<html><head><meta charset=UTF-8><title><%= title %></title><link rel="stylesheet" href="/css/terminal.css"></head>
<body><div class="terminal-container"><div class="terminal-header"><span class="terminal-title">[A04] Reset Password</span></div>
<div class="terminal-body fade-in">
<h1>Reset Password</h1>
<form method="POST" action="/insecure-design/password-reset/confirm">
  <input type="hidden" name="user_id" value="<%= user_id || 1 %>">
  <input name="new_password" placeholder="New password">
  <button>Reset</button>
</form>
<p class="hint">No token required by the API! (A04 Insecure Design)</p>
</div></div></body></html>