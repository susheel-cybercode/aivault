<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: title }) %>
<body>
<%- include('../partials/header') %>

<h1>Reset Password</h1>
<form method="POST" action="/insecure-design/password-reset/confirm">
  <input type="hidden" name="user_id" value="<%= user_id || 1 %>">
  <input name="new_password" placeholder="New password">
  <button>Reset</button>
</form>
<p class="hint">No token required by the API! (A04 Insecure Design)</p>

<%- include('../partials/footer') %>
</body>
</html>
