<!DOCTYPE html>
<html><head><meta charset=UTF-8><title><%= title %></title><link rel="stylesheet" href="/css/terminal.css"></head>
<body><div class="terminal-container"><div class="terminal-header"><span class="terminal-title">[A04] Forgot Password</span></div>
<div class="terminal-body fade-in">
<h1>Forgot Password</h1>
<form method="POST" action="/insecure-design/forgot-password">
  <input name="email" placeholder="Email address" value="admin@aivault.local">
  <button>Reset Password</button>
</form>
<p class="hint">The reset token is predictable: {username}-reset-{timestamp}</p></div></div></body></html>