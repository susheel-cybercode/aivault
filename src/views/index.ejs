      <!-- OWASP API Top 10 -->
      <div class="category" id="api">
        <h2>🟡 OWASP Top 10 API Security (2023)</h2>
        <div class="challenge-grid">
          <div class="challenge-card">
            <h3>API1: Broken Object Level Authz</h3>
            <ul>
              <li><code>GET /api/b1/users/1/profile</code></li>
              <li><code>GET /api/b1/users/2/orders</code></li>
              <li><code>PATCH /api/b1/users/1</code></li>
            </ul>
          </div>
          <div class="challenge-card">
            <h3>API2: Broken Authentication</h3>
            <ul>
              <li><code>POST /api/auth/login</code></li>
              <li><code>POST /api/auth/verify</code> (JWT none attack)</li>
            </ul>
          </div>
          <div class="challenge-card">
            <h3>API3: Mass Assignment</h3>
            <ul>
              <li><code>POST /b3/users</code></li>
            </ul>
          </div>
          <div class="challenge-card">
            <h3>API4: Unrestricted Resources</h3>
            <ul>
              <li><code>GET /api/users?expand=yes</code></li>
            </ul>
          </div>
          <div class="challenge-card">
            <h3>API5: Broken Function Authz</h3>
            <ul>
              <li><code>DELETE /api/users/:id</code></li>
              <li><code>GET /api/admin/users</code></li>
            </ul>
          </div>
          <div class="challenge-card">
            <h3>API6: Business Flow Abuse</h3>
            <ul>
              <li><code>POST /api/coupon/apply</code></li>
              <li><code>POST /api/purchase</code></li>
            </ul>
          </div>
          <div class="challenge-card">
            <h3>API7: SSRF</h3>
            <ul>
              <li><code>GET /api/fetch-url</code></li>
            </ul>
          </div>
          <div class="challenge-card">
            <h3>API8: Security Misconfig</h3>
            <ul>
              <li><code>GET /api/config</code></li>
              <li><code>GET /api/error</code></li>
            </ul>
          </div>
          <div class="challenge-card">
            <h3>API9: Inventory Mgmt</h3>
            <ul>
              <li><code>/api/v1/users</code></li>
              <li><code>/api/legacy/users</code></li>
