      <!-- Search filter -->
      <div style="margin:1rem 0 1.5rem; text-align:center;">
        <input type="text" id="moduleSearch" placeholder="> grep modules..." />
      </div>

      <script>
      (function(){
        var box = document.getElementById('moduleSearch');
        box.addEventListener('input', function(){
          var q = this.value.trim().toLowerCase();
          var cats = document.querySelectorAll('.category');
          cats.forEach(function(cat){
            var text = cat.textContent.toLowerCase();
            var match = !q || text.indexOf(q) !== -1;
            cat.style.display = match ? '' : 'none';
            if (match && q) {
              cat.style.order = '0';
            }
          });
        });
      })();
      </script>

