<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title }) %>
<link rel="stylesheet" href="/css/campaign.css">
<body>
<%- include('partials/header', { user, faction, factionName }) %>

  <div class="campaign-wrap">
    <div class="campaign-header">
      <p class="warning">CAMPAIGN // GUIDED OPERATION</p>
      <h1>The ECHO-7 Operation</h1>
      <p class="campaign-sub">
        A guided walkthrough of the Vault. Finish each chapter, then mark it complete
        to unlock the next. Every seal you break moves the story forward.
      </p>

      <div class="campaign-progress">
        <div class="campaign-progress-bar" style="width:<%= Math.round((completed.length / steps.length) * 100) %>%;"></div>
      </div>
      <div class="campaign-progress-label">
        <%= completed.length %> / <%= steps.length %> seals broken
      </div>
    </div>

    <!-- CURRENT SCENE -->
    <% const sp = speakers[nextStep.speaker]; %>
    <section class="scene-card" style="--char:<%= sp.color %>;">
      <div class="scene-art">
        <img src="<%= sp.art %>" alt="<%= sp.name %>" />
      </div>
      <div class="scene-dialog">
        <div class="scene-meta">
          <span class="scene-chapter"><%= nextStep.chapter %></span>
          <h2><%= nextStep.title %></h2>
          <span class="scene-speaker">— <%= sp.name %></span>
        </div>
        <div class="bubble">
          <p><%= nextStep.line %></p>
        </div>
        <p class="scene-narration"><%= nextStep.scene %></p>

        <% if (allDone) { %>
          <p class="scene-status done">✓ Story complete — every seal is broken.</p>
        <% } else if (completed.includes(nextStep.id)) { %>
          <p class="scene-status done">✓ Chapter complete. Seal broken.</p>
        <% } %>

        <div class="scene-actions">
          <% if (!completed.includes(nextStep.id) || allDone) { %>
            <a href="<%= nextStep.url %>" class="button scene-start">Start Chapter</a>
          <% } %>
          <% if (!allDone && completed.includes(nextStep.id)) { %>
            <form action="/campaign/complete/<%= nextStep.id %>" method="POST" style="margin:0;">
              <button type="submit" class="button scene-next">Next Chapter &rarr;</button>
            </form>
          <% } else if (!allDone) { %>
            <form action="/campaign/complete/<%= nextStep.id %>" method="POST" style="margin:0;">
              <button type="submit" class="button scene-next">Mark Complete &amp; Continue &rarr;</button>
            </form>
          <% } %>
        </div>
      </div>
    </section>

    <!-- TIMELINE -->
    <section class="chapter-list">
      <h3 class="chapter-list-title">Operation Timeline</h3>
      <ol>
        <% steps.forEach(step => { %>
          <% const done = completed.includes(step.id); %>
          <% const now = !allDone && nextStep.id === step.id; %>
          <li class="chapter-row <%= done ? 'is-done' : '' %> <%= now ? 'is-now' : '' %>">
            <span class="chapter-mark"><%= done ? '✓' : (now ? '▶' : '🔒') %></span>
            <span class="chapter-name">
              <span class="chapter-episode"><%= step.chapter %> · <%= speakers[step.speaker].name %></span>
              <strong><%= step.title %></strong>
            </span>
            <% if (done) { %>
              <span class="chapter-tag done-tag">Complete</span>
            <% } else if (now) { %>
              <span class="chapter-tag now-tag">Now</span>
            <% } else { %>
              <span class="chapter-tag locked-tag">Locked</span>
            <% } %>
          </li>
        <% }) %>
      </ol>
    </section>

    <div class="campaign-footer">
      <a href="/story/vault">Enter the ECHO Vault &rarr;</a> ·
      <a href="/story/scoreboard">Ranks &rarr;</a> ·
      <a href="/">Back to Home</a>
    </div>
  </div>

<%- include('partials/footer') %>
</body>
</html>
