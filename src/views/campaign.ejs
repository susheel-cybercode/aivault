<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/terminal.css">
</head>
<body>
  <div class="terminal-container">
    <div class="terminal-header">
      <span class="terminal-title">[CAMPAIGN] <%= title %></span>
    </div>
    <div class="terminal-body fade-in">
      <h1>AIVault Campaign Mode</h1>
      <p>Follow the story step‑by‑step. After you finish a challenge, click "Mark as Completed" to unlock the next chapter.</p>

      <ul class="challenge-grid" style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));">
        <% steps.forEach(step => { %>
          <li class="challenge-card">
            <h3><%= step.title %></h3>
            <p><%= step.description %></p>
            <% if (completed.includes(step.id)) { %>
              <p style="color:#00ff41;">✅ Completed</p>
            <% } else if (nextStep.id === step.id) { %>
              <a href="<%= step.url %>" class="button" style="background:#ff3366; color:white; padding:0.4rem 0.8rem; display:inline-block; margin-top:0.5rem;">Start</a>
            <% } else { %>
              <p style="color:#888;">🔒 Locked – complete earlier steps first</p>
            <% } %>
            <% if (completed.includes(step.id)) { %>
              <form action="/campaign/complete/<%= step.id %>" method="POST" style="margin-top:0.5rem;">
                <button type="submit" style="background:#00ff41; color:#111; border:none; padding:0.4rem 0.8rem; cursor:pointer;">Mark as Completed</button>
              </form>
            <% } %>
          </li>
        <% }) %>
      </ul>

      <hr>
      <div class="footer">
        <p><a href="/">← Back to Home</a></p>
      </div>
    </div>
  </div>
</body>
</html>
