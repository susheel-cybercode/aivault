  </div>
</div>

<!-- Back to top button -->
<button id="backToTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" style="position:fixed;bottom:2rem;right:2rem;z-index:9999;display:none;background:linear-gradient(135deg,#00e5ff,#00ff9d);border:none;width:44px;height:44px;border-radius:50%;cursor:pointer;font-size:1.2rem;color:#0a0a12;box-shadow:0 4px 16px rgba(0,229,255,0.4);transition:opacity 0.3s,transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">↑</button>
<script>
(function(){
  var btn = document.getElementById('backToTop');
  window.addEventListener('scroll', function() {
    btn.style.display = window.scrollY > 400 ? 'block' : 'none';
  });
  // Sakura petals
  for (var i = 0; i < 10; i++) {
    var p = document.createElement('div');
    p.className = 'petal';
    p.style.left = Math.random() * 100 + '%';
    p.style.animationDuration = (8 + Math.random() * 7) + 's';
    p.style.animationDelay = (Math.random() * 5) + 's';
    var s = 6 + Math.random() * 8;
    p.style.width = s + 'px';
    p.style.height = s + 'px';
    p.style.background = i % 2 === 0 ? '#ff2e88' : '#00e5ff';
    p.style.borderRadius = '50% 0 50% 50%';
    p.style.transform = 'rotate(' + (Math.random() * 360) + 'deg)';
    document.body.appendChild(p);
  }
})();
</script>
</body>
</html>
