</div>
  </div>

<script src="/js/challenge-viewer.js"></script>
<script>
  // Scroll reveal — fade in elements as they enter viewport
  (function () {
    var reveals = document.querySelectorAll('.category, .data-card, .challenge-card');
    reveals.forEach(function (el) { el.classList.add('reveal'); });
    if (!('IntersectionObserver' in window)) {
      reveals.forEach(function (el) { el.classList.add('visible'); });
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });
    reveals.forEach(function (el) { observer.observe(el); });
  })();

  // Back-to-top button
  (function(){
    var btn = document.createElement('button');
    btn.textContent = '^';
    btn.setAttribute('aria-label', 'Back to top');
    btn.style.cssText = 'position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;display:none;'+
      'background:#000;border:1px solid var(--phosphor);width:40px;height:40px;'+
      'cursor:pointer;font-size:1rem;color:var(--phosphor);border-radius:0;'+
      'transition:none;font-family:inherit;font-weight:700;';
    btn.onmouseenter = function(){ btn.style.background = 'var(--phosphor)'; btn.style.color = '#000'; };
    btn.onmouseleave = function(){ btn.style.background = '#000'; btn.style.color = 'var(--phosphor)'; };
    document.body.appendChild(btn);
    window.addEventListener('scroll', function(){
      btn.style.display = window.scrollY > 400 ? 'block' : 'none';
    });
    btn.onclick = function(){ window.scrollTo({top:0,behavior:'smooth'}); };
  })();
</script>
</body>
</html>
