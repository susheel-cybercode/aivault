<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: title }) %>
<body class="vault-bg">
<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/story.css">
<div class="vault-container">
  <div class="vault-hero-row" style="justify-content:center;gap:1.25rem;">
    <div class="art-badge" style="margin:0;width:96px;"><img src="/art/<%= faction === 'aegis' ? 'aegis' : (faction === 'null' ? 'null' : 'echo7') %>.svg" alt="faction emblem" /></div>
  </div>
  <h1 class="vault-title" style="margin-top:0.5rem;">WAR ROOM SCOREBOARD</h1>
  <p class="vault-sub">Live breach tally — every seal cracked across every faction.</p>

  <% if (faction) { %>
  <div class="player-card" style="border-top:8px solid <%= faction === 'aegis' ? 'var(--cyan)' : 'var(--pink)' %>;">
    <div class="player-card-header">
      <div>
        <span class="faction-tag">[<%= faction === 'aegis' ? 'AEGIS WARDEN' : 'NULL COLLECTIVE' %>]</span>
        <span class="faction-name"><%= handle || 'anonymous' %></span>
      </div>
      <div>
        <span class="progress-stat"><%= myProgress.points %></span>
        <span class="progress-pct">PTS</span>
      </div>
    </div>
    <div class="progress-bar"><div class="progress-fill" style="width: <%= myProgress.percentage %>%; background: <%= faction === 'aegis' ? 'var(--cyan)' : 'var(--pink)' %>"></div></div>
    <p style="margin-top:0.75rem;color:var(--on-dark-2);">Rank: <strong style="color:<%= faction === 'aegis' ? 'var(--cyan)' : 'var(--pink)' %>"><%= myRank.current.name %></strong> · <%= myProgress.completedCount %>/<%= myProgress.totalChapters %> solved</p>
    <% if (myRank.next) { %>
      <p style="margin-top:0.25rem;color:var(--text-3);font-size:0.8rem">Next rank in <%= myRank.pointsToNext %> points → <em><%= myRank.next.name %></em></p>
    <% } else { %>
      <p style="margin-top:0.25rem;color:var(--amber);font-size:0.8rem"> ★ Max rank achieved — Legendary.</p>
    <% } %>
  </div>

  <% if (achievements.length) { %>
    <div style="margin-top:1.5rem">
      <h2 style="color:var(--text);">Achievements Earned</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:0.75rem">
        <% achievements.forEach(a => { %>
          <div style="padding:0.75rem;background:var(--paper);border:1px solid var(--border);border-radius:var(--radius-xs);box-shadow:0 0 16px rgba(0,255,157,0.2);">
            <strong style="color:var(--green-glow)">★ <%= a.name %></strong><br>
            <small style="color:var(--text-2)"><%= a.desc %></small>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
  <% } else { %>
    <p style="text-align:center;padding:1rem;background:var(--paper);border:3px solid var(--ink);box-shadow:var(--shadow);color:var(--text-2);">
      <a href="/story" style="color:var(--brand);font-weight:700;">→ Join a faction to get on the board</a>
    </p>
  <% } %>

  <h2 style="margin-top:2rem;color:var(--text);">Challenge Solve Counts (global)</h2>
  <table>
    <thead><tr><th>Chapter</th><th>Solves</th><th>Difficulty</th><th>Points</th></tr></thead>
    <tbody>
      <% if (board.length === 0) { %>
        <tr><td colspan="4" style="text-align:center;color:var(--text-3)"><em>No seals cracked yet. Be the first.</em></td></tr>
      <% } %>
      <% board.forEach(b => {
        const ch = story.chapters.find(c => `${c.pillar}:${c.id}` === b.challenge_id);
        const solved = completed.includes(b.challenge_id);
      %>
        <tr style="<%= solved ? 'background:rgba(0,255,157,0.1)' : '' %>">
          <td><code><%= b.challenge_id %></code> <%= ch ? ch.name : '' %></td>
          <td><%= b.solves %></td>
          <td><%= ch ? '★'.repeat(ch.difficulty) : '?' %></td>
          <td><%= ch ? (ch.difficulty * 10) : 0 %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <footer>
    <a href="/story/vault">← Back to Vault</a>
  </footer>
</div>

<%- include('../partials/footer') %>
</body>
</html>
