<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: title }) %>
<body class="vault-bg">
<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/story.css">

<!-- ===== Cinematic Story Overlay ===== -->
<div class="story-overlay" id="story-overlay">
  <div class="scanlines"></div>
  <div class="scan-bar"></div>

  <div class="story-cinematic-layout">
    <div class="story-art-side">
      <% if (factionKey === 'aegis') { %>
        <img src="/art/aegis.svg" alt="Aegis Warden" class="story-character-art" />
      <% } else { %>
        <img src="/art/null.svg" alt="Null Collective operative" class="story-character-art" />
      <% } %>
    </div>
    <div class="story-lines" id="story-lines-wrap">
      <div class="story-chapter-badge"><%= chapter.code %> · <%= chapter.category %></div>
      <div class="story-chapter-title"><%= chapter.name %></div>
      <div id="story-lines"></div>
    </div>
  </div>

  <button class="story-skip" id="story-skip">SKIP STORY ▸▸</button>
  <button class="story-begin" id="story-begin">BEGIN MISSION</button>
</div>

<script>
window.__storyLines = [
  'Three years after the Blank Tuesday incident...',
  'The seals placed upon ECHO-7 grow weak.',
  'Layer <%= chapter.code %> guards the <%= chapter.category %> seal.',
  '<%= chapter.summary %>',
  <% if (faction.role === 'Defender') { %>
  'Your oath as a Warden: identify the flaw. Seal it.',
  <% } else { %>
  'Your mission as Null Collective: exploit it. Peel the seal.',
  <% } %>
  'The Vault awaits.'
];
var s = document.createElement('script');
s.src = '/js/story-cinematic.js';
document.head.appendChild(s);
</script>

<div class="chapter-container">
  <a href="/story/vault" class="back-link">← Return to Vault</a>

  <div class="chapter-header">
    <span class="chapter-code"><%= chapter.code %></span>
    <h1><%= chapter.name %></h1>
    <h3><%= chapter.category %></h3>
  </div>

  <div class="chapter-briefing">
    <h3>[ CHAPTER BRIEFING — FACTION: <%= faction.name.toUpperCase() %> ]</h3>
    <p><%= chapter.summary %></p>
    <p class="faction-objective">
      Objective: <em><%= faction.role === 'Defender' ? 'Identify and patch this vulnerability' : 'Exploit this vulnerability to peel the seal' %></em>
    </p>
    <% if (completed) { %>
      <p class="completed-stamp">✓ SEAL CRACKED — You have pierced layer: <%= chapter.code %></p>
    <% } else { %>
      <p class="pending-stamp">⊙ Seal intact. Solve the challenge to crack it.</p>
    <% } %>
  </div>

  <div class="access-points">
    <h4>ACCESS POINTS:</h4>
    <% const links = {
      a01: [['IDOR Profile','/broken-access?id=1'],['Admin Panel','/broken-access/admin'],['Path Traversal','/broken-access/download?file=/etc/passwd']],
      a02: [['Crypto Debug','/crypto-fails/debug/config'],['JWT Forge','/crypto-fails/forge-token?username=admin&role=admin']],
      a03: [['SQLi Search','/injection/sqli/search?q=admin'],['Reflected XSS','/injection/xss/reflected?name=test'],['Stored XSS','/injection/xss/stored'],['Command Inj','/injection/command-injection']],
      a04: [['Forgot Password','/insecure-design/forgot-password'],['2FA Bypass','/insecure-design/2fa-bypass']],
      a05: [['Default Creds','/security-misconfig/default-creds'],['Debug Panel','/security-misconfig/debug']],
      a06: [['Vulnerable Components','/vuln-components']],
      a07: [['Exposed Creds','/auth-failures/exposed-credentials']],
      a08: [['Integrity Fails','/integrity-fails']],
      a09: [['Logging Fails','/logging-fails']],
      a10: [['SSRF','/ssrf']],
      api1: [['BOLA','/api/b1/users/2/profile'],['IDOR Orders','/api/b1/users/2/orders']],
      api2: [['API Login','/api/b2/auth/login'],['JWT None','/api/b2/auth/verify']],
      api3: [['Mass Assign','POST /api/b3/users']],
      api4: [['Expansive Query','/api/users?expand=yes']],
      api5: [['Admin API','/api/admin/users']],
      api6: [['Coupon','POST /api/coupon/apply']],
      api7: [['API SSRF','/api/fetch-url?url=http://localhost:3000/']],
      api8: [['API Config','/api/config']],
      api9: [['Legacy','/api/legacy/users'],['v1','/api/v1/users']],
      api10: [['Process URL','/api/process-url']],
      m1: [['Mobile Login','/mobile/m1/api/login'],['Refresh Token','/mobile/m1/api/refresh-token']],
      m2: [['SDK','/mobile/m2/sdk/1.0']],
      m3: [['Mobile Profile','/mobile/m3/api/profile'],['2FA Bypass','/mobile/m3/api/2fa/verify']],
      m4: [['Mobile Search','/mobile/m4/api/search']],
      m5: [['Health','/mobile/m5/api/health']],
      m6: [['PII Leak','/mobile/m6/api/user-data']],
      m7: [['Debug Info','/mobile/m7/api/debug-info']],
      m8: [['Admin Creds','/mobile/m8/api/admin-credentials']],
      m9: [['Insecure Storage','/mobile/m9/api/storage']],
      m10: [['AES-ECB','/mobile/m10/api/encrypt?data=test']],
      llm01: [['Prompt Injection','/llm/llm01/chat']],
      llm02: [['Verify','/llm/llm02/execute']],
      llm03: [['Poison','/llm/llm03/poisoned-data']],
      llm04: [['DoS','/llm/llm04/chat']],
      llm05: [['Supply Chain','/llm/llm05/models']],
      llm06: [['Leak','/llm/llm06/chat']],
      llm07: [['Plugin Exec','/llm/llm07/plugin/execute']],
      llm08: [['Agency','/llm/llm08/assistant']],
      llm09: [['Overreliance','/llm/llm09/decide']],
      llm10: [['Model Info','/llm/llm10/model-info']],
      c1: [['Metadata','/cloud/metadata']],
      c2: [['Container Escape','/cloud/container-escape']],
      c3: [['IAM Role','/cloud/iam']]
    };
    const k = chapter.id.replace(/^api\d+_alt$/,'api8_alt');
    const linksForChapter = links[chapter.id] || links[k] || [];
    %>
    <ul>
      <% linksForChapter.forEach(l => { %>
        <% if (/^(POST|PUT|DELETE) /i.test(l[1])) { %>
          <li><code><%= l[1] %></code> — <span class="ap-label"><%= l[0] %></span></li>
        <% } else { %>
          <li><a href="<%= l[1] %>" target="_blank">→ <%= l[0] %></a></li>
        <% } %>
      <% }) %>
      <% if (linksForChapter.length === 0) { %><li><em>Direct endpoint access required (see source)</em></li><% } %>
    </ul>
  </div>

  <% if (!completed) { %>
    <div class="submit-section">
      <h4>Submit The Flag</h4>
      <p class="hint" style="color:var(--text-2);">After exploiting the vulnerability, paste the <code>FLAG{...}</code> you found to crack this seal.</p>
      <input id="flag-input" placeholder="FLAG{...}">
      <button onclick="submitFlag()" class="crack-button">Crack This Seal</button>
      <div id="result"></div>
    </div>
  <% } else { %>
    <div class="seal-cracked-banner">
      ✓ SEAL CRACKED · Flag: <code><%= chapter.flag %></code>
    </div>
  <% } %>

  <div class="hint-section">
    <h4>HINTS (escalating — try harder first):</h4>
    <button onclick="showHint(1)" class="hint-button">Hint 1</button>
    <button onclick="showHint(2)" class="hint-button">Hint 2</button>
    <button onclick="showHint(3)" class="hint-button">Hint 3 (spoiler)</button>
    <div id="hint-text"></div>
  </div>

  <div class="source-viewer">
    <h4>Source View (DVWA-style)</h4>
    <details>
      <summary>View the vulnerable server-side code &rarr;</summary>
      <iframe src="/story/chapter/<%= pillar %>/<%= chapter.id %>/source"></iframe>
    </details>
  </div>
</div>

<script>
async function submitFlag() {
  const flag = document.getElementById('flag-input').value.trim();
  if (!flag) return alert('Enter a flag');
  const r = await fetch('/story/chapter/<%= pillar %>/<%= chapter.id %>/submit-flag', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ flag })
  });
  const j = await r.json();
  const result = document.getElementById('result');
  if (j.success) {
    result.className = 'result-ok';
    result.innerHTML = '✓ ' + j.message +
      '<div class="result-meta">Progress: ' + j.progress.completedCount + '/' + j.progress.totalChapters +
      ' ('+ j.progress.percentage +'%) · ' + j.progress.points + ' points · Rank: ' + j.rank.current.name + '</div>' +
      (j.nextChapter ? '<div class="result-next"><a href="/story/chapter/'+j.nextChapter.pillar+'/'+j.nextChapter.id+'">Next: '+j.nextChapter.name+' &rarr;</a></div>' : '') +
      (j.points_awarded ? '<div class="result-points">+'+ j.points_awarded +' points awarded</div>' : '');
    setTimeout(() => window.location.reload(), 2500);
  } else {
    result.className = 'result-err';
    result.textContent = '✗ ' + (j.error || 'Incorrect flag');
  }
}
async function showHint(n) {
  const r = await fetch('/story/chapter/<%= pillar %>/<%= chapter.id %>/hint/'+n);
  const j = await r.json();
  document.getElementById('hint-text').textContent = '[Hint '+n+'/'+j.total+'] ' + j.hint;
}
</script>

<%- include('../partials/footer') %>
</body>
</html>
