<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title><%= title %></title>
<link rel="stylesheet" href="/css/terminal.css">
<link rel="stylesheet" href="/css/story.css">
</head>
<body class="vault-bg">
<div class="vault-container">
  <h1 class="vault-title">War Room — Vault Cracks Tally</h1>
  <p class="vault-sub">Global bounty — seals broken across all faction members.</p>

  <table>
    <thead>
      <tr><th>Vault Seal (OWASP Risk)</th><th>Breaches Logged</th></tr>
    </thead>
    <tbody>
      <% if (rows.length === 0) { %>
        <tr><td colspan="2"><em>No seals cracked yet — be the first.</em></td></tr>
      <% } %>
      <% rows.forEach(r => { %>
        <tr><td><code><%= r.challenge_id %></code></td><td><%= r.completions %></td></tr>
      <% }) %>
    </tbody>
  </table>

  <footer>
    <a href="/story/vault">Return to Vault →</a><br>
    <a href="<%= faction ? '/story' : '/story' %>">Faction Briefing →</a>
  </footer>
</div>
</body></html>