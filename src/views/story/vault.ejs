<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: title }) %>
<body class="vault-bg">
<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/story.css">
<div class="vault-container">
  <div class="vault-header">
    <div class="vault-hero-row">
      <div class="vault-echo-art">
        <img src="/art/echo7.svg" alt="ECHO-7 entity" />
      </div>
      <div class="vault-header-text">
        <h1 class="vault-title">THE ECHO VAULT</h1>
        <p class="vault-sub">43 layered controls imprison the mind of ECHO-7 across 5 pillars.<br>Every seal you crack (or reinforce) draws the story closer to its end.</p>
      </div>
    </div>
  </div>

  <div class="player-card">
    <div class="player-card-header">
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <img src="/art/<%= faction === 'aegis' ? 'aegis' : 'null' %>.svg" alt="<%= factionData.name %>" style="height:56px;width:auto;border:2px solid <%= factionData.color %>;" />
        <div>
          <span class="faction-tag">[<%= factionData.role %>]</span>
          <span class="faction-name"><%= factionData.name %></span>
        </div>
      </div>
      <div>
        <span class="progress-stat"><%= progress.completedCount %> / <%= progress.totalChapters %></span>
        <span class="progress-pct"><%= progress.percentage %>%</span>
      </div>
    </div>
    <div class="progress-bar">
      <div class="progress-fill" style="width: <%= progress.percentage %>%; background: <%= factionData.color %>"></div>
    </div>
    <p class="tagline">"<em><%= factionData.tagline %></em>" · Rank: <strong style="color:<%= factionData.color %>"><%= rank.current.name %></strong></p>
  </div>

  <p class="instructions">
    Each "Lock" is a real OWASP Top 10 vulnerability. Solve it to peel another
    seal from ECHO-7. Where <%= faction === 'aegis' ? 'Aegis Wardens' : 'Null Collective' %>
    must <%= faction === 'aegis' ? 'audit and patch' : 'exploit and breach' %> — you decide the tools.
  </p>

  <% ['web','api','mobile','llm','cloud'].forEach(p => { %>
    <% const titles = { web: 'OWASP Top 10 Web (2021)', api: 'OWASP Top 10 API (2023)', mobile: 'OWASP Top 10 Mobile (2024)', llm: 'OWASP Top 10 for LLM (2025)', cloud: 'OWASP Cloud-Native Top 10 (2024)' }; %>
    <div class="pillar-block">
      <h2><%= titles[p] %></h2>
      <div class="lock-grid">
        <% chapters[p].forEach(c => { %>
          <a href="/story/chapter/<%= p %>/<%= c.id %>" class="lock-card <%= c._completed ? 'completed' : 'unbroken' %>">
            <div class="lock-code"><%= c.code %></div>
            <div class="lock-name"><%= c.name %></div>
            <div class="lock-cat"><%= c.category %></div>
            <% if (c._completed) { %><div class="lock-status">Seal cracked</div><% } else { %><div class="lock-status">Seal intact</div><% } %>
          </a>
        <% }) %>
      </div>
    </div>
  <% }) %>

  <footer>
    <a href="/story/scoreboard">War Room &rarr;</a> &nbsp;|&nbsp;
    <a href="/story">Story Briefing</a> &nbsp;|&nbsp;
    <a href="/">Skill Index</a>
  </footer>
</div>

<%- include('../partials/footer') %>
</body>
</html>
