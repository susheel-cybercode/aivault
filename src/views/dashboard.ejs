<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title }) %>
<body>
<%- include('partials/header') %>

<h2>// DASHBOARD</h2>
<p>Welcome, <strong><%= user.username %></strong>. Your role: <strong><%= user.role %></strong></p>

<h3>// YOUR_POSTS</h3>
<% if (posts && posts.length > 0) { %>
  <ul>
    <% posts.forEach(p => { %>
      <li><strong><%= p.title %></strong>: <%= p.content %></li>
    <% }) %>
  </ul>
<% } else { %>
  <p>No posts yet.</p>
<% } %>

<h3>// QUICK_LINKS</h3>
<ul>
  <li><a href="/broken-access?id=1">View User Profile (IDOR)</a></li>
  <li><a href="/injection">SQL Injection Lab</a></li>
</ul>

<%- include('partials/footer') %>
</body>
</html>
