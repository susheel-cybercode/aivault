<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: title }) %>
<body>
<%- include('../partials/header') %>

<h1>Server-Side Request Forgery</h1>
<form method="GET" action="/ssrf/fetch">
  <input name="url" placeholder="Enter URL the server should fetch" value="http://localhost:3000/">
  <button>Fetch</button>
</form>
<p class="hint">Try cloud metadata: <code>?url=http://169.254.169.254/latest/meta-data/</code></p>
<p>Or internal service: <code>?url=http://localhost:3000/?flag=true</code></p>

<%- include('../partials/footer') %>
</body>
</html>
